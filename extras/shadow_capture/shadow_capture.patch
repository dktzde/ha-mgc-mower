@@ -486,6 +486,99 @@ async def _async_register_services(hass: HomeAssistant) -> None:
             schema=set_mowing_schedule_schema,
         )
 
+    # Debug extra (extras/shadow_capture): poll the "property" and "service" shadows
+    # quickly and log every new version as WARNING, including "desired" (the last
+    # command, e.g. sent by the R HOME app). Read-only, nothing is sent to the mower.
+    capture_schema = vol.Schema(
+        {
+            vol.Optional("duration", default=300): vol.All(
+                vol.Coerce(int), vol.Range(min=5, max=1800)
+            ),
+            vol.Optional("interval", default=0.5): vol.All(
+                vol.Coerce(float), vol.Range(min=0.2, max=10)
+            ),
+            vol.Optional(ATTR_SERIAL_NUMBER): vol.Any(cv.string, [cv.string]),
+            vol.Optional("entity_id"): vol.Any(cv.entity_id, [cv.entity_id]),
+        },
+        extra=vol.ALLOW_EXTRA,
+    )
+
+    async def _async_capture(coordinator, duration: int, interval: float) -> None:
+        client = coordinator.client
+        loop = asyncio.get_running_loop()
+        end = loop.time() + duration
+        last: dict[str, object] = {}
+        _LOGGER.warning("CAPTURE start (%s s, every %s s)", duration, interval)
+        # Once at the start: all field names of the property shadow, for orientation.
+        try:
+            first = await client._async_get_named_shadow_reported_state("property")
+            _LOGGER.warning("CAPTURE property keys=%s", sorted(first))
+        except HandwiseGenieApiError as err:
+            _LOGGER.warning("CAPTURE property error: %s", err)
+        while loop.time() < end:
+            for name in ("property", "service"):
+                try:
+                    await client._async_get_named_shadow_reported_state(name)
+                except HandwiseGenieApiError as err:
+                    _LOGGER.warning("CAPTURE %s error: %s", name, err)
+                    continue
+                payload = getattr(client, "_last_shadow_payload", {}).get(name) or {}
+                state = payload.get("state") or {}
+                reported = state.get("reported") or {}
+                # Fields watched for changes: rain settings, schedule, cutting height/direction.
+                key = (
+                    payload.get("version"),
+                    reported.get("rainer_ctl"),
+                    reported.get("mow_delay_time"),
+                    str(state.get("desired")),
+                    str(reported.get("appointment")),
+                    str(reported.get("appointment_time")),
+                    reported.get("cutter_height"),
+                    str(reported.get("cutter_direction")),
+                )
+                if last.get(name) != key:
+                    last[name] = key
+                    _LOGGER.warning(
+                        "CAPTURE %s v%s rainer_ctl=%s mow_delay_time=%s desired=%s "
+                        "delta=%s meta_desired=%s appointment=%s appointment_time=%s "
+                        "cutter_height=%s cutter_direction=%s",
+                        name,
+                        payload.get("version"),
+                        reported.get("rainer_ctl"),
+                        reported.get("mow_delay_time"),
+                        state.get("desired"),
+                        state.get("delta"),
+                        (payload.get("metadata") or {}).get("desired"),
+                        reported.get("appointment"),
+                        reported.get("appointment_time"),
+                        reported.get("cutter_height"),
+                        reported.get("cutter_direction"),
+                    )
+            await asyncio.sleep(interval)
+        _LOGGER.warning("CAPTURE end")
+
+    async def _handle_capture_shadow(service_call) -> None:
+        targets = _resolve_target_coordinators(hass, service_call.data)
+        if not targets:
+            raise HandwiseGenieApiError("No target Handwise mower found")
+        for coordinator in targets:
+            hass.async_create_background_task(
+                _async_capture(
+                    coordinator,
+                    service_call.data["duration"],
+                    service_call.data["interval"],
+                ),
+                "mgc_mower_capture_shadow",
+            )
+
+    if not hass.services.has_service(DOMAIN, "capture_shadow"):
+        hass.services.async_register(
+            DOMAIN,
+            "capture_shadow",
+            _handle_capture_shadow,
+            schema=capture_schema,
+        )
+
 
