{#- MGC Mower example: weekly mowing schedule from dashboard helpers.
    Copy this file to <config>/custom_templates/mgc_mower_schedule.jinja
    (used by mgc_mower_schedule.yaml, see extras/dashboard/README.md).

    One entry per ticked day, same time and cutting height for all days.
    Direction rule (change it in mgc_schedule_entries below):
    Monday = cross, the other ticked days alternate perpendicular / parallel
    (starting with perpendicular). -#}

{#- Entries in the format of mgc_mower.set_mowing_schedule (as JSON text) -#}
{%- macro mgc_schedule_entries() -%}
{%- set days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] -%}
{%- set ns = namespace(entries=[], n=0) -%}
{%- set start = states('input_datetime.mgc_schedule_start')[:5] -%}
{%- set end = none if is_state('input_boolean.mgc_schedule_until_finished', 'on') else states('input_datetime.mgc_schedule_end')[:5] -%}
{%- set height = states('input_number.mgc_schedule_height') | int(55) -%}
{%- for day in days if is_state('input_boolean.mgc_schedule_' ~ day, 'on') -%}
  {%- if day == 'mon' -%}
    {%- set direction = 'cross' -%}
  {%- else -%}
    {%- set direction = ['perpendicular', 'parallel'][ns.n % 2] -%}
    {%- set ns.n = ns.n + 1 -%}
  {%- endif -%}
  {%- set ns.entries = ns.entries + [{'weekday': day, 'start': start, 'end': end, 'cutter_height': height, 'direction': direction}] -%}
{%- endfor -%}
{{- ns.entries | to_json -}}
{%- endmacro -%}

{#- Comparison key of an entry list (same format as attribute "entries" of the schedule sensor) -#}
{%- macro mgc_schedule_key(entries) -%}
{%- set ns = namespace(parts=[]) -%}
{%- for e in entries or [] -%}
  {%- set ns.parts = ns.parts + [e.weekday ~ '|' ~ e.start ~ '|' ~ e.end ~ '|' ~ e.cutter_height ~ '|' ~ e.direction] -%}
{%- endfor -%}
{{- ns.parts | sort | join(';') -}}
{%- endmacro -%}

{#- Readable text, e.g. "Mon 17:00–19:00 cross 55 mm · Wed 17:00–19:00 perpendicular 55 mm".
    lang: 'en' (default), 'de' or 'fr' -#}
{%- macro mgc_schedule_text(entries, lang='en') -%}
{%- set texts = {
  'en': {'days': {'mon': 'Mon', 'tue': 'Tue', 'wed': 'Wed', 'thu': 'Thu', 'fri': 'Fri', 'sat': 'Sat', 'sun': 'Sun'},
         'directions': {'perpendicular': 'perpendicular', 'parallel': 'parallel', 'cross': 'cross'},
         'until_finished': 'until finished', 'empty': 'no day ticked – no scheduled mowing'},
  'de': {'days': {'mon': 'Mo', 'tue': 'Di', 'wed': 'Mi', 'thu': 'Do', 'fri': 'Fr', 'sat': 'Sa', 'sun': 'So'},
         'directions': {'perpendicular': 'senkrecht', 'parallel': 'parallel', 'cross': 'Kreuz'},
         'until_finished': 'bis fertig', 'empty': 'kein Tag gewählt – kein Mähplan'},
  'fr': {'days': {'mon': 'lun', 'tue': 'mar', 'wed': 'mer', 'thu': 'jeu', 'fri': 'ven', 'sat': 'sam', 'sun': 'dim'},
         'directions': {'perpendicular': 'perpendiculaire', 'parallel': 'parallèle', 'cross': 'croisé'},
         'until_finished': "jusqu'à la fin", 'empty': 'aucun jour coché – pas de tonte planifiée'},
} -%}
{%- set t = texts.get(lang, texts['en']) -%}
{%- set ns = namespace(parts=[]) -%}
{%- for e in entries or [] -%}
  {%- set ns.parts = ns.parts + [t.days.get(e.weekday, e.weekday) ~ ' ' ~ e.start ~ '–' ~ (e.end or t.until_finished) ~ ' ' ~ t.directions.get(e.direction, e.direction) ~ ' ' ~ e.cutter_height ~ ' mm'] -%}
{%- endfor -%}
{{- ns.parts | join(' · ') if ns.parts else t.empty -}}
{%- endmacro -%}
